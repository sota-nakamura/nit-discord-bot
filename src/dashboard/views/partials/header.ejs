<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/beercss@5.0.3/dist/cdn/beer.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0"
        rel="stylesheet">
</head>

<body>
    <header>
        <nav>
            <img src="<%= bot.avatarURL ? bot.avatarURL : '' %>" alt="<%= bot.username %>" class="circle">
            <h6 class="max">
                <%= bot.username %>
            </h6>
            <button class="chip">
                <%= bot.status %>
            </button>
        </nav>
    </header>