{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":preserveSemverRanges"
  ],
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "matchPackagePatterns": [
        "better-sqlite3",
        "discord.js",
        "dotenv",
        "express",
        "node-cron",
        "sqlite3"
      ],
      "automerge": false
    }
  ]
}